<Window x:Class="WallpaperScheduler.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperScheduler.App"
        Title="Wallpaper Scheduler" Width="1180" Height="860" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wallpaper Scheduler" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,0" Text="Ciclo diário personalizável · arquivos, pastas, rotação e perfis lógicos de monitor" Opacity="0.65"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="120" Height="36" Margin="0,0,10,0" Content="Salvar" Command="{Binding SaveCommand}"/>
                <Button Width="140" Height="36" Content="Aplicar agora" Command="{Binding ApplyNowCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14" Background="White" BorderBrush="#22000000" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{Binding MonitorDiagnostics}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Width="110" Height="30" Content="Atualizar" Command="{Binding RefreshMonitorsCommand}"/>
                </Grid>

                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding MonitorProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Esquecer este monitor" Click="ForgetMonitor_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome lógico e portátil deste monitor"/>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Status}" Opacity="0.62" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Períodos do dia" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" Opacity="0.62" Text="Todos os períodos podem ser alterados, removidos ou recriados. O escopo define se a fonte é global ou independente por monitor."/>
                </StackPanel>
                <Button Grid.Column="1" Width="130" Height="34" Content="+ Novo período" Command="{Binding AddPeriodCommand}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Periods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,14" Padding="18" Background="White" BorderBrush="#22000000" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding Enabled}" Content="Ativo"/>
                                        <TextBox Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontWeight="SemiBold" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Margin="18,0,6,0" VerticalAlignment="Center" Text="Início"/>
                                        <local:Time24TextBox Grid.Column="3" Width="72" Height="32" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Horário em formato 24 horas (HH:mm)"/>
                                        <TextBlock Grid.Column="4" Margin="12,0,6,0" VerticalAlignment="Center" Text="Fim"/>
                                        <local:Time24TextBox Grid.Column="5" Width="72" Height="32" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Horário em formato 24 horas (HH:mm)"/>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock VerticalAlignment="Center" Text="Rotação" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" Height="30" ItemsSource="{Binding DataContext.RotationModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding RotationMode}"/>
                                        <TextBlock Grid.Column="2" Margin="16,0,8,0" VerticalAlignment="Center" Text="Intervalo"/>
                                        <TextBox Grid.Column="3" Height="30" VerticalContentAlignment="Center" TextAlignment="Center" Text="{Binding RotationIntervalMinutes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ToolTip="Minutos; vazio = somente ao entrar no período"/>
                                        <TextBlock Grid.Column="4" Margin="16,0,8,0" VerticalAlignment="Center" Text="Ajuste"/>
                                        <ComboBox Grid.Column="5" Height="30" ItemsSource="{Binding DataContext.WallpaperStyles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Style}"/>
                                        <TextBlock Grid.Column="6" Margin="16,0,8,0" VerticalAlignment="Center" Text="Escopo"/>
                                        <ComboBox Grid.Column="7" Height="30" ItemsSource="{Binding DataContext.WallpaperScopes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Scope, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <StackPanel Margin="0,16,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllMonitors}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Fonte global"/>
                                        <Border Padding="16" MinHeight="88" AllowDrop="True" Drop="WallpaperDropZone_Drop" Tag="{Binding}"
                                                BorderThickness="2" BorderBrush="#667A7F8A" CornerRadius="10" Background="#FAFBFC">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Arraste e solte wallpapers ou pastas aqui" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Margin="0,4,0,0" Text="Aplicada igualmente a todos os monitores ativos." Opacity="0.58" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Margin="0,7,0,0" IsChecked="{Binding IncludeSubfolders}" Content="Incluir subpastas"/>

                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Sources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="10,3" Content="Remover" Click="RemoveSource_Click" Tag="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,16,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPerMonitor}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Fontes independentes por monitor"/>
                                        <ItemsControl ItemsSource="{Binding MonitorSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="12" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Background="#FCFCFD">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProfileName}"/>
                                                                <CheckBox Grid.Column="1" IsChecked="{Binding IncludeSubfolders}" Content="Incluir subpastas"/>
                                                            </Grid>
                                                            <Border Margin="0,8,0,0" Padding="12" MinHeight="58" AllowDrop="True" Drop="MonitorWallpaperDropZone_Drop" Tag="{Binding}"
                                                                    BorderThickness="1" BorderBrush="#667A7F8A" CornerRadius="7" Background="White">
                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Arraste arquivos ou pastas para este monitor" Opacity="0.7"/>
                                                            </Border>
                                                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Sources}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                                            <Button Grid.Column="1" Margin="10,0,0,0" Padding="8,2" Content="Remover" Click="RemoveMonitorSource_Click" Tag="{Binding}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Opacity="0.55" VerticalAlignment="Center" Text="O escopo selecionado define qual conjunto de fontes será usado."/>
                                        <Button Grid.Column="1" Width="120" Height="30" Content="Excluir período" Command="{Binding DataContext.RemovePeriodCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="12" Background="White" BorderBrush="#22000000" BorderThickness="1" CornerRadius="8">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
