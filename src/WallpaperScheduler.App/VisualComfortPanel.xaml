<UserControl x:Class="WallpaperScheduler.App.VisualComfortPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperScheduler.App"
             x:Name="ComfortRoot">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{DynamicResource ComfortIconBrush}" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE890;" FontSize="20"
                           Foreground="{DynamicResource ComfortAccentBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Conforto visual" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Tema e adaptação cromática sincronizados ao relógio local e aos períodos já existentes."
                           Style="{StaticResource SectionSubtitleStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Módulo mestre" Margin="0,0,10,0" FontSize="11"
                           FontWeight="SemiBold" Foreground="{DynamicResource ComfortAccentBrush}"/>
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ComfortEnabled}"/>
            </StackPanel>
        </Grid>

        <!-- Aparência local: independente do módulo de conforto. -->
        <Border CornerRadius="13" Padding="14" Margin="0,14,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE790;" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Aparência do aplicativo" FontWeight="SemiBold"/>
                    <TextBlock Text="Tema da interface do Wallpaper Scheduler; independente do controle do tema do Windows."
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding ApplicationThemeModes}"
                          SelectedItem="{Binding ApplicationTheme}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <UniformGrid Columns="3" Margin="0,12,0,0" IsEnabled="{Binding ComfortModulesEnabled}">
            <!-- Tema do Windows -->
            <Border CornerRadius="13" Padding="14" Margin="0,0,10,0"
                    Background="{DynamicResource ComfortCardBrush}"
                    BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ComfortIconBrush}" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE706;" FontSize="18" Foreground="{DynamicResource ComfortAccentBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tema do Windows" FontWeight="SemiBold"/>
                                <TextBlock Text="Claro / escuro" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ThemeEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding ThemeEnabled}">
                        <TextBlock Text="Controle" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding VisualControlModes}" SelectedItem="{Binding ThemeControlMode}" Margin="0,5,0,0">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsThemeManual, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Estado manual" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ManualThemeMode}" Margin="0,5,0,0">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsThemeScheduled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Claro a partir de" Style="{StaticResource FieldLabelStyle}"/>
                                    <local:Time24TextBox Text="{Binding ThemeLightStartText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Escuro a partir de" Style="{StaticResource FieldLabelStyle}"/>
                                    <local:Time24TextBox Text="{Binding ThemeDarkStartText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Usa o relógio local da máquina e recalcula após suspensão, desbloqueio ou mudança de horário."
                                       Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Temperatura: curva contínua, sem segundo cronograma. -->
            <Border CornerRadius="13" Padding="14" Margin="0,0,10,0"
                    Background="{DynamicResource ComfortCardBrush}"
                    BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ComfortIconBrush}" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE9CA;" FontSize="18" Foreground="{DynamicResource ComfortAccentBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Temperatura e tom" FontWeight="SemiBold"/>
                                <TextBlock Text="Curva contínua de 24 horas" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding TemperatureEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding TemperatureEnabled}">
                        <TextBlock Text="Perfil diário" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Height="18" CornerRadius="9" Margin="0,6,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F09A45" Offset="0"/>
                                    <GradientStop Color="#F6C56E" Offset="0.22"/>
                                    <GradientStop Color="#EAF4FF" Offset="0.43"/>
                                    <GradientStop Color="#EAF4FF" Offset="0.60"/>
                                    <GradientStop Color="#F6C56E" Offset="0.80"/>
                                    <GradientStop Color="#F09A45" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Madrugada" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="Manhã" HorizontalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="Dia" HorizontalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="Tarde" HorizontalAlignment="Center" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="Noite" HorizontalAlignment="Right" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>

                        <TextBlock Text="Calor noturno" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0"/>
                        <Slider Minimum="3400" Maximum="6500" Value="{Binding NightTemperatureKelvin}"
                                SmallChange="50" LargeChange="200" Margin="0,6,0,0"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mais quente · 3400 K" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="Neutro · 6500 K" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Perfil noturno atual: "/><Run Text="{Binding NightTemperatureKelvin}"/><Run Text=" K"/>
                        </TextBlock>

                        <TextBlock Text="A curva usa os horários dos períodos existentes: a Manhã retorna progressivamente ao neutro, o Dia permanece neutro, a Tarde aquece de forma contínua e Noite/Madrugada mantêm o perfil quente. Não há janela de transição iniciada ao abrir o programa."
                                   Margin="0,9,0,0" FontSize="9.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Text="Método técnico de aplicação" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                        <ComboBox ItemsSource="{Binding TemperatureMethods}" SelectedItem="{Binding TemperatureMethod}" Margin="0,5,0,0">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Este campo escolhe somente como a curva é aplicada ao monitor; não cria horários nem altera a onda."
                                   Margin="0,5,0,0" FontSize="9.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <CheckBox IsChecked="{Binding ForceSoftwareConflict}" Margin="0,9,0,0"
                                  Content="Forçar mesmo com outro filtro detectado" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Rotina: não cria uma segunda estrutura de períodos. -->
            <Border CornerRadius="13" Padding="14"
                    Background="{DynamicResource ComfortCardBrush}"
                    BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ComfortIconBrush}" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8F1;" FontSize="18" Foreground="{DynamicResource ComfortAccentBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Rotina visual" FontWeight="SemiBold"/>
                                <TextBlock Text="Usa Períodos do dia" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RoutineEnabled}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding RoutineEnabled}">
                        <TextBlock Text="A Rotina visual usa a estrutura original de Períodos do dia abaixo. Este painel não cria, substitui nem reorganiza esse cronograma."
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Madrugada, Manhã, Dia, Tarde e Noite continuam pertencendo ao scheduler principal; temperatura e tema apenas acompanham esses períodos."
                                   Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Valores de temperatura já associados a períodos antigos são tratados como pontos da curva, com interpolação entre eles, e não como saltos instantâneos."
                                   Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Expander Header="Método por monitor e diagnóstico" Margin="0,10,0,0" IsEnabled="{Binding ComfortModulesEnabled}">
            <StackPanel Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding MonitorProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataContext.TemperatureMethods, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                          SelectedItem="{Binding TemperatureMethod}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,8,0,0" Padding="10" CornerRadius="8"
                        Background="{DynamicResource ComfortStatusBrush}"
                        BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding TemperatureDiagnostics}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshComfortCommand}"
                        Content="Atualizar capacidades" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>