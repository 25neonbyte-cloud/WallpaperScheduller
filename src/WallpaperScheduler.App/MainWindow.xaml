<Window x:Class="WallpaperScheduler.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallpaper Scheduler" Width="980" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Wallpaper Scheduler" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" Text="Windows 11 · regras por dia, horário e monitor" Opacity="0.7"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,28,0,16" Padding="20" BorderThickness="1" BorderBrush="#33000000" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Monitores detectados" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,12,24,0" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding MonitorDiagnostics}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="130" Height="34" VerticalAlignment="Top" Content="Atualizar" Command="{Binding RefreshMonitorsCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="24" BorderThickness="1" BorderBrush="#33000000" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Teste de aplicação" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="A configuração é lida de %LOCALAPPDATA%\WallpaperScheduler\config.json. O botão abaixo avalia a regra vigente, detecta os monitores ativos e aplica o estado calculado usando IDesktopWallpaper."/>
                <Button Margin="0,24,0,0" Width="150" Height="38" HorizontalAlignment="Left" Content="Aplicar agora" Command="{Binding ApplyNowCommand}"/>
                <TextBlock Margin="0,18,0,0" Text="{Binding Status}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,18,0,0" Opacity="0.55" Text="Baseline v0.2 — diagnóstico multi-monitor para validação dos Device Paths."/>
    </Grid>
</Window>
