<Window x:Class="WallpaperScheduler.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WallpaperScheduler.App"
 Title="Wallpaper Scheduler" MinWidth="760" MinHeight="520" WindowStartupLocation="Manual"
 Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="14,18,14,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,0,18"><TextBlock Text="Wallpaper Scheduler" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="vNext" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
    <StackPanel Grid.Row="1">
     <Button Style="{StaticResource NavButtonStyle}" Tag="home" Click="Navigate_Click" Content="⌂   Início"/>
     <Button Style="{StaticResource NavButtonStyle}" Tag="schedule" Click="Navigate_Click" Content="▣   Agendamento"/>
     <Button Style="{StaticResource NavButtonStyle}" Tag="monitors" Click="Navigate_Click" Content="▭   Monitores"/>
     <Button Style="{StaticResource NavButtonStyle}" Tag="comfort" Click="Navigate_Click" Content="◉   Conforto visual"/>
     <Button x:Name="SettingsButton" Style="{StaticResource NavButtonStyle}" Click="Settings_Click" Content="⚙   Configurações">
      <Button.ContextMenu><ContextMenu><MenuItem Header="Importar configuração…" Click="ImportConfig_Click"/><MenuItem Header="Exportar configuração…" Click="ExportConfig_Click"/><Separator/><MenuItem Header="Abrir diagnósticos / logs" Click="OpenDiagnostics_Click"/></ContextMenu></Button.ContextMenu>
     </Button>
    </StackPanel>
    <Border Grid.Row="3" Padding="12" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="Seu ambiente visual, organizado para acompanhar o seu dia." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
   </Grid>
  </Border>
  <ScrollViewer x:Name="MainScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="22,20,22,18">
    <Grid x:Name="HomeSection" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Wallpaper Scheduler" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Papéis de parede que se adaptam à sua rotina." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Content="Salvar" Command="{Binding SaveCommand}"/><Button Style="{StaticResource PrimaryButtonStyle}" Content="▶  Aplicar agora" Command="{Binding ApplyNowCommand}"/></StackPanel>
    </Grid>
    <Border x:Name="MonitorsSection" Margin="0,0,0,14" Padding="16" CornerRadius="14" Background="{DynamicResource MonitorGroupBrush}" BorderBrush="{DynamicResource MonitorGroupBorderBrush}" BorderThickness="1">
     <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▭  Monitores ativos" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding MonitorDiagnostics}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Atualizar" Command="{Binding RefreshMonitorsCommand}"/></Grid>
      <ItemsControl ItemsSource="{Binding MonitorProfiles}" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="12"><Grid><Grid.ContextMenu><ContextMenu><MenuItem Header="Esquecer este monitor" Click="ForgetMonitor_Click"/></ContextMenu></Grid.ContextMenu><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" BorderThickness="0" Padding="0" Background="Transparent"/><TextBlock Text="●  Ativo" Foreground="{DynamicResource SuccessBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="⋯" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="Clique com o botão direito para opções"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
    <Border x:Name="ComfortSection" Margin="0,0,0,14" Padding="16" CornerRadius="14" Background="{DynamicResource ComfortGroupBrush}" BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
     <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◉  Conforto visual" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Recursos modulares de conforto, sem sobrecarregar a tela principal." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="Próxima etapa" Foreground="{DynamicResource ComfortAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
      <UniformGrid Columns="3" Margin="0,10,0,0">
       <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Padding="14" Tag="Tema do sistema" Click="PlannedFeature_Click"><StackPanel><TextBlock Text="☀☾  Tema do sistema" FontWeight="SemiBold"/><TextBlock Text="Claro/escuro automático e sincronização com o Windows." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Button>
       <Button Style="{StaticResource BaseButtonStyle}" Margin="0,0,8,0" Padding="14" Tag="Temperatura e tom" Click="PlannedFeature_Click"><StackPanel><TextBlock Text="☼  Temperatura e tom" FontWeight="SemiBold"/><TextBlock Text="Mudança gradual de cor ao longo do dia." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Button>
       <Button Style="{StaticResource BaseButtonStyle}" Padding="14" Tag="Rotina visual" Click="PlannedFeature_Click"><StackPanel><TextBlock Text="◒  Rotina visual" FontWeight="SemiBold"/><TextBlock Text="Presets de conforto associados aos períodos." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Button>
      </UniformGrid>
     </StackPanel>
    </Border>
    <Border x:Name="ScheduleSection" Padding="16" CornerRadius="14" Background="{DynamicResource ScheduleGroupBrush}" BorderBrush="{DynamicResource ScheduleGroupBorderBrush}" BorderThickness="1">
     <StackPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="▣  Períodos do dia" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Abra apenas o período que deseja editar." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="+  Novo período" Command="{Binding AddPeriodCommand}"/></Grid>
      <ItemsControl ItemsSource="{Binding Periods}" AlternationCount="1000"><ItemsControl.ItemTemplate><DataTemplate>
       <Expander Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}"><Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="False"/><Style.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter Property="IsExpanded" Value="True"/></Trigger></Style.Triggers></Style></Expander.Style>
        <Expander.Header><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Enabled}" Margin="0,0,10,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" BorderThickness="0" Padding="0" Background="Transparent" MinWidth="130"/><TextBlock Text="{Binding StartText}" Margin="12,1,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text=" – " Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding EndText}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="editar" Foreground="{DynamicResource ScheduleAccentBrush}" VerticalAlignment="Center"/></Grid></Expander.Header>
        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,4,0,0"><StackPanel>
         <UniformGrid Columns="4"><StackPanel Margin="0,0,8,0"><TextBlock Text="Início" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><local:Time24TextBox Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Fim" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><local:Time24TextBox Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="Rotação" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox ItemsSource="{Binding DataContext.RotationModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding RotationMode}" Height="32" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock Text="Intervalo (min)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Text="{Binding RotationIntervalMinutes, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Height="32" Margin="0,4,0,0"/></StackPanel></UniformGrid>
         <StackPanel Orientation="Horizontal" Margin="0,12,0,8"><TextBlock Text="Fonte / escopo" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Tag="{Binding}" Click="SetGlobalScope_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAllMonitors}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="Fonte global"/></Button><Button Margin="6,0,0,0" Tag="{Binding}" Click="SetPerMonitorScope_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsPerMonitor}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="Por monitor"/></Button></StackPanel>
         <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAllMonitors}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border AllowDrop="True" Drop="WallpaperDropZone_Drop" Tag="{Binding}" Padding="13" MinHeight="58" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"><TextBlock Text="＋  Arraste imagens ou pastas aqui · JPG/JPEG, PNG e BMP" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/></Border><CheckBox Margin="0,6,0,0" IsChecked="{Binding IncludeSubfolders}" Content="Incluir subpastas"/><ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Style="{StaticResource NavButtonStyle}" Padding="6,0" Content="Remover" Click="RemoveSource_Click" Tag="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
         <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPerMonitor}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><ItemsControl ItemsSource="{Binding MonitorSources}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,6"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"/><CheckBox Grid.Column="1" IsChecked="{Binding IncludeSubfolders}" Content="Subpastas"/></Grid><Border AllowDrop="True" Drop="MonitorWallpaperDropZone_Drop" Tag="{Binding}" Margin="0,6,0,0" Padding="9" CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"><TextBlock Text="Arraste imagens ou pastas para este monitor" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/></Border><ItemsControl ItemsSource="{Binding Sources}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Style="{StaticResource NavButtonStyle}" Padding="6,0" Content="Remover" Click="RemoveMonitorSource_Click" Tag="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
         <Expander Header="Opções avançadas" Margin="0,8,0,0"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Ajuste da imagem" FontSize="11"/><ComboBox ItemsSource="{Binding DataContext.WallpaperStyles, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Style}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Prioridade" FontSize="11"/><TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Content="Excluir período" Command="{Binding DataContext.RemovePeriodCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></Expander>
        </StackPanel></Border>
       </Expander>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Column="1" Grid.Row="1" Padding="14,9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="●  Pronto" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Margin="14,0" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Style="{StaticResource NavButtonStyle}" Padding="8,2" Content="Ver logs" Click="OpenDiagnostics_Click"/></Grid></Border>
 </Grid>
</Window>