<UserControl x:Class="WallpaperScheduler.App.VisualComfortPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperScheduler.App"
             x:Name="ComfortRoot">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{DynamicResource ComfortIconBrush}" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE890;" FontSize="20"
                           Foreground="{DynamicResource ComfortAccentBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Conforto visual" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Tema, temperatura de cor e rotina com automação pelo relógio local do Windows."
                           Style="{StaticResource SectionSubtitleStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Módulo mestre" Margin="0,0,10,0" FontSize="11"
                           FontWeight="SemiBold" Foreground="{DynamicResource ComfortAccentBrush}"/>
                <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ComfortEnabled}"/>
            </StackPanel>
        </Grid>

        <!-- A aparência do próprio programa é independente do módulo de conforto. -->
        <Border CornerRadius="13" Padding="14" Margin="0,14,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE790;" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Aparência do aplicativo" FontWeight="SemiBold"/>
                    <TextBlock Text="Tema da interface do Wallpaper Scheduler; funciona mesmo com o Conforto visual desligado."
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding ApplicationThemeModes}"
                          SelectedItem="{Binding ApplicationTheme}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <UniformGrid Columns="3" Margin="0,12,0,0" IsEnabled="{Binding ComfortModulesEnabled}">
            <!-- Tema do Windows -->
            <Border CornerRadius="13" Padding="14" Margin="0,0,10,0"
                    Background="{DynamicResource ComfortCardBrush}"
                    BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ComfortIconBrush}" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE706;" FontSize="18" Foreground="{DynamicResource ComfortAccentBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tema do Windows" FontWeight="SemiBold"/>
                                <TextBlock Text="Claro / escuro" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ThemeEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding ThemeEnabled}">
                        <TextBlock Text="Controle" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding VisualControlModes}" SelectedItem="{Binding ThemeControlMode}" Margin="0,5,0,0">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsThemeManual, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Estado manual" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ManualThemeMode}" Margin="0,5,0,0">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsThemeScheduled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Claro a partir de" Style="{StaticResource FieldLabelStyle}"/>
                                    <local:Time24TextBox Text="{Binding ThemeLightStartText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Escuro a partir de" Style="{StaticResource FieldLabelStyle}"/>
                                    <local:Time24TextBox Text="{Binding ThemeDarkStartText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="O horário é o relógio local da máquina; iniciar o programa mais tarde não reinicia o ciclo."
                                       Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="A Rotina visual só sobrescreve este controle quando um período define Claro ou Escuro explicitamente."
                                   Margin="0,8,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Temperatura -->
            <Border CornerRadius="13" Padding="14" Margin="0,0,10,0"
                    Background="{DynamicResource ComfortCardBrush}"
                    BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ComfortIconBrush}" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE9CA;" FontSize="18" Foreground="{DynamicResource ComfortAccentBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Temperatura e tom" FontWeight="SemiBold"/>
                                <TextBlock Text="Relógio local + Software/DDC/CI" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding TemperatureEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding TemperatureEnabled}">
                        <TextBlock Text="Controle" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding VisualControlModes}" SelectedItem="{Binding TemperatureControlMode}" Margin="0,5,0,0">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Margin="0,9,0,0">
                            <TextBlock Text="Método técnico de aplicação" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding TemperatureMethods}" SelectedItem="{Binding TemperatureMethod}" Margin="0,5,0,0">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Isto escolhe como a cor chega ao monitor; não define horários."
                                       Margin="0,5,0,0" FontSize="9.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsTemperatureManual, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Temperatura manual (K)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding ManualTemperatureKelvin, UpdateSourceTrigger=LostFocus}"
                                     local:NumericTextBoxBehavior.IsEnabled="True" Padding="10,0" Height="34" Margin="0,5,0,0"
                                     ToolTip="Faixa: 3400–6500 K."/>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding IsTemperatureScheduled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Dia a partir de" Style="{StaticResource FieldLabelStyle}"/>
                                    <local:Time24TextBox Text="{Binding TemperatureDayStartText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,5,0,0"/>
                                    <TextBlock Text="Temperatura dia (K)" Style="{StaticResource FieldLabelStyle}" Margin="0,7,0,0"/>
                                    <TextBox Text="{Binding DayTemperatureKelvin, UpdateSourceTrigger=LostFocus}"
                                             local:NumericTextBoxBehavior.IsEnabled="True" Height="34" Padding="10,0" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Noite a partir de" Style="{StaticResource FieldLabelStyle}"/>
                                    <local:Time24TextBox Text="{Binding TemperatureNightStartText, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,5,0,0"/>
                                    <TextBlock Text="Temperatura noite (K)" Style="{StaticResource FieldLabelStyle}" Margin="0,7,0,0"/>
                                    <TextBox Text="{Binding NightTemperatureKelvin, UpdateSourceTrigger=LostFocus}"
                                             local:NumericTextBoxBehavior.IsEnabled="True" Height="34" Padding="10,0" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Transição (min)" Style="{StaticResource FieldLabelStyle}" Margin="0,9,0,0"/>
                        <TextBox Text="{Binding TemperatureTransitionMinutes, UpdateSourceTrigger=LostFocus}"
                                 local:NumericTextBoxBehavior.IsEnabled="True" Padding="10,0" Height="34" Margin="0,5,0,0"/>
                        <TextBlock Text="No automático por horário, o ponto da transição é calculado pelo relógio local; abrir o app no meio dela aplica diretamente o valor correspondente."
                                   Margin="0,6,0,0" FontSize="9.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <CheckBox IsChecked="{Binding ForceSoftwareConflict}" Margin="0,9,0,0"
                                  Content="Forçar mesmo com outro filtro detectado" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Rotina -->
            <Border CornerRadius="13" Padding="14"
                    Background="{DynamicResource ComfortCardBrush}"
                    BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource ComfortIconBrush}" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8F1;" FontSize="18" Foreground="{DynamicResource ComfortAccentBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Rotina visual" FontWeight="SemiBold"/>
                                <TextBlock Text="Sobrescrita por período" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RoutineEnabled}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="0,12,0,0" IsEnabled="{Binding RoutineEnabled}">
                        <TextBlock Text="Usa os mesmos períodos do agendamento de wallpaper. Um valor explícito aqui tem prioridade sobre o controle base por horário."
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="'Usar controle base' e temperatura vazia preservam o manual/automático definido nos módulos ao lado."
                                   Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Ao retornar de suspensão ou alterar o relógio, o estado correto para aquele horário é recalculado."
                                   Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Expander Header="Rotina por período" Margin="0,12,0,0" IsEnabled="{Binding ComfortModulesEnabled}">
            <ItemsControl ItemsSource="{Binding Periods}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                            <ComboBox Grid.Column="1" Margin="8,0"
                                      ItemsSource="{Binding DataContext.RoutineThemeTargets, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                      SelectedItem="{Binding RoutineTheme}"
                                      IsEnabled="{Binding DataContext.RoutineEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="2" Margin="8,0,0,0" Height="32" Padding="10,0"
                                     Text="{Binding RoutineTemperatureKelvin, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     local:NumericTextBoxBehavior.IsEnabled="True"
                                     IsEnabled="{Binding DataContext.RoutineEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                     ToolTip="Temperatura em K (3400–6500). Deixe vazio para usar o controle base."/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <Expander Header="Método por monitor e diagnóstico" Margin="0,8,0,0" IsEnabled="{Binding ComfortModulesEnabled}">
            <StackPanel Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding MonitorProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataContext.TemperatureMethods, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                          SelectedItem="{Binding TemperatureMethod}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,8,0,0" Padding="10" CornerRadius="8"
                        Background="{DynamicResource ComfortStatusBrush}"
                        BorderBrush="{DynamicResource ComfortGroupBorderBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding TemperatureDiagnostics}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshComfortCommand}"
                        Content="Atualizar capacidades" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
